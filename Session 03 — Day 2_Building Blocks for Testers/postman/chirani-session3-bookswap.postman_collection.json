    {
      "name": "06 - Search books by ISBN and check privacy",
      "request": {
        "method": "GET",
        "header": [
          {"key": "Authorization", "value": "Bearer {{token}}", "type": "text"},
          {"key": "Content-Type", "value": "application/json", "type": "text"}
        ],
        "url": {
          "raw": "{{baseUrl}}/books?search=9789552100012",
          "host": ["{{baseUrl}}"],
          "path": ["books"],
          "query": [{"key": "search", "value": "9789552100012"}]
        }
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
            "const body = pm.response.json();",
            "pm.test('Response does not expose phone or address fields', function () {",
            "  const responseText = JSON.stringify(body).toLowerCase();",
            "  pm.expect(responseText).not.to.include('\"phone\"');",
            "  pm.expect(responseText).not.to.include('\"address\"');",
            "});"
          ]
        }
      }]
    },
